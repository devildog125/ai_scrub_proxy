<Project>
  <!-- Shared build settings for every project in the solution, so no csproj repeats them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>          <!-- .NET 10 LTS is the only runtime we target (PLAN.md §4). -->
    <Nullable>enable</Nullable>                          <!-- Nullable reference types on: null bugs surface at compile time. -->
    <ImplicitUsings>enable</ImplicitUsings>              <!-- Common System namespaces imported everywhere. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>  <!-- A warning is a bug we have not read yet; fail the build. -->
    <LangVersion>latest</LangVersion>                    <!-- Use the C# version that ships with the pinned SDK. -->
    <InvariantGlobalization>true</InvariantGlobalization><!-- No culture-specific behaviour; detection must be deterministic everywhere. -->
  </PropertyGroup>
</Project>
