# Copy to .env (gitignored) and fill in real values. Never commit the real file.

# SQL Server connection for the audit sink. Encrypt=Strict and
# TrustServerCertificate=false are mandatory; the service refuses to start without them.
# Prefer Windows Integrated or Entra ID auth over a SQL login.
AI_SCRUB_PROXY_AUDIT_CONNECTION="Server=sql.example.invalid;Database=AiScrubAudit;Integrated Security=true;Encrypt=Strict;TrustServerCertificate=false"
