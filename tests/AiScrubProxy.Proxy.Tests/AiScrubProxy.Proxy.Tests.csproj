<Project Sdk="Microsoft.NET.Sdk">
  <!-- xUnit tests for the proxy: pass-through of paths, headers, bodies and streams. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable> <!-- Test projects are never packaged. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />              <!-- Test host, MIT. -->
    <PackageReference Include="xunit" Version="2.9.3" />                                  <!-- Test framework, Apache-2.0. -->
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />              <!-- Runner adapter for `dotnet test`, Apache-2.0. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />    <!-- In-process host for the proxy under test, MIT. -->
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" /> <!-- Every test file gets the xUnit namespace without repeating the using. -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AiScrubProxy.Proxy\AiScrubProxy.Proxy.csproj" /> <!-- The system under test. -->
  </ItemGroup>
</Project>
